<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Not initialized"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/initButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Init SDK" />

        <Button
            android:id="@+id/identifyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Identify User" />

        <Button
            android:id="@+id/showFormButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Show Form (modal)" />

        <Button
            android:id="@+id/showInlineFormButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Show Form (inline slot below)" />

        <com.encatch.android.EncatchInlineFormView
            android:id="@+id/inlineForm"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
