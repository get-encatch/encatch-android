# cinterop definition for the ios-native/ pure-Swift SDK's @objc bridge
# (ios-native/Sources/Encatch/ObjCBridge/EncatchBridge.swift).
#
# Kotlin/Native's cinterop only understands compiled Objective-C headers — it can't consume a
# Swift module directly. `ios-native/`'s generated `-Swift.h` header (produced via
# `xcodebuild build -scheme Encatch -destination ...`, see the plan doc at
# /Users/godwin/.claude/plans/stateless-floating-ripple.md) plus its compiled static library are
# what we cinterop against here.
#
# Artifacts are pre-built by hand into ios-native/dist/{ios-arm64,sim-arm64}/ (device vs Simulator
# Apple Silicon) — see that directory's contents (`libEncatch.a`, `Encatch-Swift.h`,
# `Encatch.swiftmodule`). Per-target paths below use cinterop's `.<target>` property-suffix
# mechanism so one .def file serves both `iosArm64` and `iosSimulatorArm64` Gradle targets.
language = Objective-C
package = com.encatch.bridge

# The generated -Swift.h header references UIKit types (UIView/UIViewController) as superclasses
# without importing UIKit itself (Xcode normally supplies that via the consuming app target's own
# imports) — list it first so cinterop's indexer can resolve them.
headers = UIKit/UIKit.h Encatch-Swift.h
compilerOpts.ios_arm64 = -I/Users/godwin/Desktop/cmss/encatch/encatch-android/ios-native/dist/ios-arm64 -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk -F/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk/System/Library/Frameworks
compilerOpts.ios_simulator_arm64 = -I/Users/godwin/Desktop/cmss/encatch/encatch-android/ios-native/dist/sim-arm64 -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk -F/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk/System/Library/Frameworks

staticLibraries = libEncatch.a
libraryPaths.ios_arm64 = /Users/godwin/Desktop/cmss/encatch/encatch-android/ios-native/dist/ios-arm64
libraryPaths.ios_simulator_arm64 = /Users/godwin/Desktop/cmss/encatch/encatch-android/ios-native/dist/sim-arm64

# The Swift runtime's own shared libraries (libswiftCore etc.) must be resolvable at final link
# time — they ship inside the platform SDK/toolchain, not this package.
linkerOpts.ios_arm64 = -L/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/iphoneos -L/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk/usr/lib/swift
linkerOpts.ios_simulator_arm64 = -L/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/iphonesimulator -L/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk/usr/lib/swift
